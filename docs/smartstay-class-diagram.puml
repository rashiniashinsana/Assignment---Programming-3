' ========================================================
' RELATIONSHIPS AND MULTIPLICITIES
' ========================================================

' Domain Model internal associations and compositions
2635746_Room "1" *--> "1" 2635746_RoomType : categorized by >
2635746_Room "1" *--> "1" 2635746_BedType : configured with >
2635746_Room "1" *--> "1" 2635746_RoomStatus : operational state >

2635746_Reservation "1" *--> "1" 2635746_ReservationStatus : current status >
2635746_Reservation "0..*" --> "1" 2635746_Guest : booked by >
2635746_Reservation "0..*" --> "1" 2635746_Room : reserves >

2635746_Invoice "0..1" --> "1" 2635746_Reservation : itemizes & bills >

' Repository Aggregations
2635746_RoomRepository o-- "0..*" 2635746_Room : stores in-memory >
2635746_GuestRepository o-- "0..*" 2635746_Guest : stores in-memory >
2635746_ReservationRepository o-- "0..*" 2635746_Reservation : stores in-memory >

' Service to Repository Dependencies
2635746_RoomService --> "1" 2635746_RoomRepository : delegates persistence >
2635746_RoomService ..> "0..1" 2635746_ReservationRepository : checks deletion safeguard >

2635746_GuestService --> "1" 2635746_GuestRepository : delegates persistence >

2635746_ReservationService --> "1" 2635746_RoomRepository : verifies room state >
2635746_ReservationService --> "1" 2635746_ReservationRepository : queries & stores bookings >
2635746_ReservationService ..> "0..1" 2635746_GuestRepository : verifies guest identity >
2635746_ReservationService ..> 2635746_IdGenerator : uses for ID generation >

2635746_InvoiceService --> "1" 2635746_ReservationRepository : looks up bookings >
2635746_InvoiceService o-- "0..*" 2635746_Invoice : caches invoices >

' MainFrame Composition of UI Panels & Wiring of Services
2635746_MainFrame *-- "1" 2635746_DashboardPanel
2635746_MainFrame *-- "1" 2635746_RoomManagementPanel
2635746_MainFrame *-- "1" 2635746_GuestRegistrationPanel
2635746_MainFrame *-- "1" 2635746_RoomSearchPanel
2635746_MainFrame *-- "1" 2635746_ReservationPanel
2635746_MainFrame *-- "1" 2635746_InvoicePanel

2635746_MainFrame --> "1" 2635746_RoomService
2635746_MainFrame --> "1" 2635746_GuestService
2635746_MainFrame --> "1" 2635746_ReservationService
2635746_MainFrame --> "1" 2635746_InvoiceService

' Panel to Service Dependencies
2635746_RoomManagementPanel --> "1" 2635746_RoomService
2635746_GuestRegistrationPanel --> "1" 2635746_GuestService
2635746_RoomSearchPanel --> "1" 2635746_ReservationService
2635746_ReservationPanel --> "1" 2635746_ReservationService
2635746_ReservationPanel ..> "1" 2635746_GuestService
2635746_InvoicePanel --> "1" 2635746_InvoiceService
2635746_InvoicePanel ..> "1" 2635746_ReservationService

' Main Bootstrap
2635746_Main ..> 2635746_MainFrame : instantiates & launches >
2635746_Main ..> 2635746_DatabaseManager : initializes persistence >
2635746_DatabaseManager ..> 2635746_RoomRepository : synchronizes >
2635746_DatabaseManager ..> 2635746_GuestRepository : synchronizes >
2635746_DatabaseManager ..> 2635746_ReservationRepository : synchronizes >
2635746_HotelBookingManager ..> 2635746_DatabaseManager : initializes & saves >

@enduml
